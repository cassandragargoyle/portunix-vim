<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.cassandragargoyle.portunix</groupId>
		<artifactId>vim-parser-parent</artifactId>
		<version>0.1.8-SNAPSHOT</version>
	</parent>

	<artifactId>vim-parser-lemmatizer-tk</artifactId>
	<packaging>jar</packaging>

	<name>Portunix VIM Parser - TK Stemmer Backend</name>
	<description>TK Stemmer backend plugin for vim-parser-lemmatizer (33 languages via native C++)</description>

	<properties>
		<plugin.id>tk-backend-plugin</plugin.id>
	</properties>

	<dependencies>
		<!-- VIM Parser API (for StemmedResult, StemmedToken, etc.) -->
		<dependency>
			<groupId>org.cassandragargoyle.portunix</groupId>
			<artifactId>vim-parser-api</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Lemmatizer Plugin (for LemmatizerBackend interface) -->
		<dependency>
			<groupId>org.cassandragargoyle.portunix</groupId>
			<artifactId>vim-parser-lemmatizer</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- TK Stemmer JNI library (Issue #033) -->
		<dependency>
			<groupId>org.cassandragargoyle.portunix</groupId>
			<artifactId>vim-parser-stemmer-tk</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- PF4J -->
		<dependency>
			<groupId>org.pf4j</groupId>
			<artifactId>pf4j</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Testing -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Assembly Plugin for creating plugin ZIP -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<configuration>
					<descriptors>
						<descriptor>../src/assembly/plugin-zip.xml</descriptor>
					</descriptors>
					<finalName>${plugin.id}-${project.version}</finalName>
					<appendAssemblyId>false</appendAssemblyId>
				</configuration>
				<executions>
					<execution>
						<id>make-plugin-zip</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
