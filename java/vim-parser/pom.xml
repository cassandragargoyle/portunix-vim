<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<groupId>org.cassandragargoyle.portunix</groupId>
	<artifactId>vim-parser-parent</artifactId>
	<version>0.1.8-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>Portunix VIM Parser - Parent</name>
	<description>Modular Layered Information Model (VIM) parser for semantic extraction from documents</description>

	<modules>
		<module>vim-parser-api</module>
		<module>vim-parser-core</module>
		<module>vim-parser-barcode</module>
		<module>vim-parser-fulltext</module>
		<module>vim-parser-graphics</module>
		<module>vim-parser-lemmatizer</module>
		<module>vim-parser-spayd</module>
		<module>vim-parser-stemmer-tk</module>
		<module>vim-parser-lemmatizer-tk</module>
		<module>vim-parser-morpho-morphodita</module>
		<module>vim-parser-table</module>
		<module>vim-parser-toc</module>
		<module>vim-parser-visualizer</module>
		<!-- vim-parser-it MUST be last so all plugin JARs are built before integration tests -->
		<module>vim-parser-it</module>
	</modules>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- Dependency versions -->
		<jackson.version>2.21</jackson.version>
		<picocli.version>4.7.7</picocli.version>
		<junit.version>6.0.3</junit.version>
		<pdfbox.version>3.0.7</pdfbox.version>
		<zxing.version>3.5.4</zxing.version>
		<grpc.version>1.80.0</grpc.version>
		<protobuf.version>4.34.1</protobuf.version>
		<pf4j.version>3.15.0</pf4j.version>
		<opentelemetry.version>1.61.0</opentelemetry.version>
		<cassandragargoyle-api.version>1.0.0.9</cassandragargoyle-api.version>
		<!-- Consumed from portunix-plugins (plugins/table-detector), not a reactor sibling -->
		<table-detector.version>1.0.3-SNAPSHOT</table-detector.version>

		<!-- Java version -->
		<maven.compiler.release>21</maven.compiler.release>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Internal modules -->
			<dependency>
				<groupId>org.cassandragargoyle.portunix</groupId>
				<artifactId>vim-parser-api</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.cassandragargoyle.portunix</groupId>
				<artifactId>vim-parser-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.cassandragargoyle.portunix</groupId>
				<artifactId>vim-parser-barcode</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.cassandragargoyle.portunix</groupId>
				<artifactId>vim-parser-fulltext</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.cassandragargoyle.portunix</groupId>
				<artifactId>vim-parser-graphics</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.cassandragargoyle.portunix</groupId>
				<artifactId>vim-parser-lemmatizer</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.cassandragargoyle.portunix</groupId>
				<artifactId>vim-parser-spayd</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.cassandragargoyle.portunix</groupId>
				<artifactId>vim-parser-visualizer</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.cassandragargoyle.portunix</groupId>
				<artifactId>vim-parser-table</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.cassandragargoyle.portunix</groupId>
				<artifactId>vim-parser-toc</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- CassandraGargoyle API (logging, telemetry) -->
			<dependency>
				<groupId>org.cassandragargoyle</groupId>
				<artifactId>org-cassandragargoyle-api</artifactId>
				<version>${cassandragargoyle-api.version}</version>
			</dependency>

			<!-- OpenTelemetry API (transitive via API module, explicit for compile clarity) -->
			<dependency>
				<groupId>io.opentelemetry</groupId>
				<artifactId>opentelemetry-api</artifactId>
				<version>${opentelemetry.version}</version>
			</dependency>

			<!-- PF4J Plugin Framework -->
			<dependency>
				<groupId>org.pf4j</groupId>
				<artifactId>pf4j</artifactId>
				<version>${pf4j.version}</version>
			</dependency>

			<!-- SLF4J API (explicit version to avoid mismatches with transitive deps) -->
			<dependency>
				<groupId>org.slf4j</groupId>
				<artifactId>slf4j-api</artifactId>
				<version>2.0.9</version>
			</dependency>


			<!-- Apache PDFBox for PDF processing -->
			<dependency>
				<groupId>org.apache.pdfbox</groupId>
				<artifactId>pdfbox</artifactId>
				<version>${pdfbox.version}</version>
			</dependency>

			<!-- Jackson for JSON processing BOM -->
			<dependency>
				<groupId>com.fasterxml.jackson</groupId>
				<artifactId>jackson-bom</artifactId>
				<version>2.21.2</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Picocli for CLI -->
			<dependency>
				<groupId>info.picocli</groupId>
				<artifactId>picocli</artifactId>
				<version>${picocli.version}</version>
			</dependency>

			<!-- ZXing for barcode detection -->
			<dependency>
				<groupId>com.google.zxing</groupId>
				<artifactId>core</artifactId>
				<version>${zxing.version}</version>
			</dependency>
			<dependency>
				<groupId>com.google.zxing</groupId>
				<artifactId>javase</artifactId>
				<version>${zxing.version}</version>
			</dependency>

			<!-- gRPC -->
			<dependency>
				<groupId>io.grpc</groupId>
				<artifactId>grpc-netty-shaded</artifactId>
				<version>${grpc.version}</version>
			</dependency>
			<dependency>
				<groupId>io.grpc</groupId>
				<artifactId>grpc-protobuf</artifactId>
				<version>${grpc.version}</version>
			</dependency>
			<dependency>
				<groupId>io.grpc</groupId>
				<artifactId>grpc-stub</artifactId>
				<version>${grpc.version}</version>
			</dependency>
			<dependency>
				<groupId>com.google.protobuf</groupId>
				<artifactId>protobuf-java</artifactId>
				<version>${protobuf.version}</version>
			</dependency>

			<!-- Testing dependencies -->
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-api</artifactId>
				<version>${junit.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-engine</artifactId>
				<version>${junit.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-params</artifactId>
				<version>${junit.version}</version>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<!-- Maven Compiler Plugin for Java 21 -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.12.1</version>
					<configuration>
						<release>21</release>
					</configuration>
				</plugin>

				<!-- Surefire Plugin for running tests -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.2.3</version>
				</plugin>

				<!-- Resources Plugin -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<version>3.3.1</version>
					<configuration>
						<encoding>UTF-8</encoding>
					</configuration>
				</plugin>

				<!-- JAR Plugin -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>3.3.0</version>
				</plugin>

				<!-- Shade Plugin for creating executable JAR -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-shade-plugin</artifactId>
					<version>3.5.1</version>
				</plugin>

				<!-- Assembly Plugin for creating plugin ZIPs -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-assembly-plugin</artifactId>
					<version>3.6.0</version>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<!-- Repository for latest versions -->
	<repositories>
		<repository>
			<id>central</id>
			<url>https://repo.maven.apache.org/maven2</url>
		</repository>
		<repository>
			<id>github</id>
			<url>https://maven.pkg.github.com/cassandragargoyle/api</url>
		</repository>
	</repositories>

	<!-- Developer information -->
	<developers>
		<developer>
			<id>zdenek</id>
			<name>Zdenek</name>
			<roles>
				<role>lead</role>
				<role>developer</role>
			</roles>
		</developer>
	</developers>

	<organization>
		<name>CassandraGargoyle</name>
		<url>https://github.com/cassandragargoyle</url>
	</organization>

	<scm>
		<url>https://github.com/cassandragargoyle/portunix-vim</url>
		<connection>scm:git:https://github.com/cassandragargoyle/portunix-vim.git</connection>
	</scm>
</project>
